<?xml version="1.0" encoding="utf-8"?>
<!-- Sized for the Galaxy Z Flip Flex Window (Samsung recommends 352×339dp); also works on home screens. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/glance_widget_description"
    android:initialLayout="@layout/widget_glance"
    android:minWidth="352dp"
    android:minHeight="339dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="180dp"
    android:previewLayout="@layout/widget_glance"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="4"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen|keyguard" />
