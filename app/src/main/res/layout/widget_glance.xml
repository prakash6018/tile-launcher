<?xml version="1.0" encoding="utf-8"?>
<!-- Four live tiles in a 2×2 grid, plus a now-playing strip. Colors are set at runtime from the accent. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/glance_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:padding="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tile_clock"
            style="@style/GlanceTile">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#FFFFFF"
                android:textSize="40sp" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEEE"
                android:format24Hour="EEEE"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="MMMM d"
                android:format24Hour="d MMMM"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tile_weather"
            style="@style/GlanceTile">

            <TextView
                android:id="@+id/weather_temp"
                style="@style/GlanceHeadline"
                android:text="—" />

            <TextView
                android:id="@+id/weather_line1"
                style="@style/GlanceLine" />

            <TextView
                android:id="@+id/weather_line2"
                style="@style/GlanceLine" />

            <!-- Spacer (Space isn't allowed in RemoteViews). -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                style="@style/GlanceLabel"
                android:text="weather" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tile_next"
            style="@style/GlanceTile">

            <TextView
                android:id="@+id/next_title"
                style="@style/GlanceTitle"
                android:text="no more events" />

            <TextView
                android:id="@+id/next_when"
                style="@style/GlanceLine" />

            <!-- Spacer (Space isn't allowed in RemoteViews). -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                style="@style/GlanceLabel"
                android:text="next" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tile_unread"
            style="@style/GlanceTile">

            <TextView
                android:id="@+id/unread_count"
                style="@style/GlanceHeadline"
                android:text="0" />

            <TextView
                android:id="@+id/unread_apps"
                style="@style/GlanceLine"
                android:maxLines="3" />

            <!-- Spacer (Space isn't allowed in RemoteViews). -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                style="@style/GlanceLabel"
                android:text="new" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/now_playing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
